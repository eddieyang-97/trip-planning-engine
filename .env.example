# Local-only, synthetic flight research. Never expose local mode publicly.
APP_MODE=local
PORT=3000
DATA_DIR=.data/postgres
# A random local bearer token is generated at startup when this is omitted.
# LOCAL_TOKEN=use-at-least-32-random-characters

# Hosted mode requires ALL of these plus explicit client grants in Postgres.
# APP_MODE=hosted
# DATABASE_URL=postgresql://...
# DATABASE_CA_FILE=/path/to/trusted-ca.pem
# PUBLIC_ORIGIN=https://your-service.example
# SUPABASE_AUTH_ISSUER=https://your-project.supabase.co/auth/v1
# MCP_AUDIENCE=https://your-service.example/mcp
# No live provider is implemented/enabled in this scaffold.
