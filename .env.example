# Local-only, synthetic flight research. Never expose local mode publicly.
APP_MODE=local
PORT=3000
DATA_DIR=.data/postgres
# A random local bearer token is generated at startup when this is omitted.
# LOCAL_TOKEN=use-at-least-32-random-characters

# Hosted mode requires DATABASE_URL, an HTTPS public origin, SUPABASE_AUTH_ISSUER,
# and explicit client grants in Postgres. Other settings below are optional.
# APP_MODE=hosted
# DATABASE_URL=postgresql://...
# DATABASE_PASSWORD=paste-the-original-password-here
# With DATABASE_PASSWORD set, DATABASE_URL can omit its password. Encoding is automatic.
# DATABASE_CA_FILE=/path/to/trusted-ca.pem
# PUBLIC_ORIGIN=https://your-service.example
# Render supplies RENDER_EXTERNAL_URL, used if PUBLIC_ORIGIN is omitted.
# MIGRATE_ON_START=true
# SUPABASE_AUTH_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Enables the account and consent pages. Never use a secret/service-role key.
# Optional passkey beta: default OFF. Requires separately approved exact HTTPS
# app hostname and matching Supabase Auth RP/origin setup; see docs/passkeys.md.
# PASSKEYS_ENABLED=false
# PASSKEY_RP_ID=trip-planning-engine.onrender.com
# Exact Render service hostnames are allowed; bare onrender.com is not.
# Re-enrollment is required if the RP hostname changes. Keep password/email recovery.
# MCP_AUDIENCE=https://your-service.example/mcp
# Defaults to the public origin + /mcp. Supabase OAuth tokens must be issued
# for that audience; its default 'authenticated' audience is not accepted.
# Live pilot: explicit opt-in, one easyJet LGW–GVA pair for Flaine only.
# LIVE_SEARCH_ENABLED=true
# SERPAPI_API_KEY=your-private-key
# Defaults off. Limits and unsupported routes are documented in docs/hosted-live-search.md.
# Optional standalone Free-plan probes: flights (6 searches), accommodation (5 searches).
# They share account quota with the hosted pilot. Avoid concurrent external use of the key.

# Optional map provider overrides. Defaults need no API key for this small pilot.
# MAP_SEARCH_URL=https://photon.komoot.io/api/
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Public endpoints are best effort; switch provider before expanding traffic.
